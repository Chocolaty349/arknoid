<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane fx:id="rootPane"
            xmlns="http://javafx.com/javafx/19"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.team4.arkanoid.controller.GameController"
            prefWidth="900.0" prefHeight="650.0"
            focusTraversable="true"
            onKeyPressed="#onKeyPressed"
            onKeyReleased="#onKeyReleased">

    <children>
        <Canvas fx:id="canvas"
                AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0"
                AnchorPane.topAnchor="0.0"
                AnchorPane.bottomAnchor="0.0" />

        <HBox spacing="16.0" AnchorPane.topAnchor="8.0" AnchorPane.leftAnchor="8.0">
            <!--<children>
                <Label text="Score:" style="-fx-text-fill: white; -fx-font-weight: bold;" />
                <Label fx:id="lblScore" text="0" style="-fx-text-fill: white;" />
            </children>-->
        </HBox>
    </children>
</AnchorPane>
