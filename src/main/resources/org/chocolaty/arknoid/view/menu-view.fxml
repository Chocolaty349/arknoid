<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Circle?>

<AnchorPane fx:id="root" onKeyPressed="#onKeyPressed" prefHeight="650.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.team4.arkanoid.controller.MenuController">

    <children>
        <!-- BACKGROUND -->
        <ImageView fx:id="bg" fitHeight="689.0" fitWidth="901.0" preserveRatio="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <image>
                <Image url="@../images/menu/menu_bg.png" />
            </image>
        </ImageView>

        <!-- GUIDE -->
        <Button fx:id="btnGuide" focusTraversable="false" layoutX="242.0" layoutY="474.0" onAction="#onGuide" pickOnBounds="false" prefHeight="122.0" prefWidth="122.0" style="-fx-background-color: transparent; -fx-background-radius: 0; -fx-padding: 0;" styleClass="img-btn">
            <shape><Circle radius="56" /></shape>
         <graphic>
                <ImageView fx:id="iconGuide" fitHeight="129.0" fitWidth="122.0" preserveRatio="true" smooth="true">
                    <image>
                  <Image url="@../images/menu/btn_guide.png" />
               </image>
                </ImageView>
         </graphic>
        </Button>

        <!-- PLAY -->
        <Button fx:id="btnPlay" focusTraversable="false" layoutX="373.0" layoutY="493.0" onAction="#onPlay" pickOnBounds="false" prefHeight="154.0" prefWidth="154.0" style="-fx-background-color: transparent; -fx-background-radius: 0; -fx-padding: 0;" styleClass="img-btn">
            <shape><Circle radius="64" /></shape>
         <graphic>
                <ImageView fx:id="iconPlay" fitHeight="154.0" fitWidth="154.0" preserveRatio="true" smooth="true">
                    <image>
                  <Image url="@../images/menu/btn_play.png" />
               </image>
                </ImageView>
         </graphic>
        </Button>

        <!-- QUIT -->
        <Button fx:id="btnQuit" focusTraversable="false" layoutX="538.0" layoutY="470.0" onAction="#onQuit" pickOnBounds="false" prefHeight="129.0" prefWidth="131.0" style="-fx-background-color: transparent; -fx-background-radius: 0; -fx-padding: 0;" styleClass="img-btn">
            <shape><Circle radius="56" /></shape>
         <graphic>
                <ImageView fx:id="iconQuit" fitHeight="237.0" fitWidth="122.0" preserveRatio="true" smooth="true">
                    <image>
                  <Image url="@../images/menu/btn_quit.png" />
               </image>
                </ImageView>
         </graphic>
        </Button>
    </children>
</AnchorPane>
